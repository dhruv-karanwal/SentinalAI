{
  "title": "SentinelAI - API and agent operations",
  "uid": "sentinel-ops",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "sentinelai",
    "wave-d"
  ],
  "description": "Operational metrics exported by app/ops/metrics.py. Not study results.",
  "panels": [
    {
      "id": 1,
      "title": "API requests per second by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-prom"
          },
          "expr": "sum by (status) (rate(sentinel_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "API latency p95 by path",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(sentinel_http_request_seconds_bucket[5m])))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "LLM tokens per minute by agent and direction",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-prom"
          },
          "expr": "sum by (agent, direction) (rate(sentinel_agent_tokens_total[5m])) * 60",
          "legendFormat": "{{agent}} {{direction}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "LLM requests per minute by agent",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-prom"
          },
          "expr": "sum by (agent) (rate(sentinel_agent_requests_total[5m])) * 60",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Mean case latency by agent",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-prom"
          },
          "expr": "sum by (agent) (rate(sentinel_agent_case_seconds_sum[15m])) / sum by (agent) (rate(sentinel_agent_case_seconds_count[15m]))",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Unparseable replies (total)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-prom"
          },
          "expr": "sum by (agent) (sentinel_agent_parse_failures_total)",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Claims dropped by the evidence verifier (total)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-prom"
          },
          "expr": "sum by (agent) (sentinel_verifier_dropped_claims_total)",
          "legendFormat": "{{agent}}"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
